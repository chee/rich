{
  "name": "@patchwork/rich",
  "version": "0.0.1",
  "description": "Collaborative rich text editor (Wordgard) for Patchwork",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "push": "vite build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "dev:serve": "vite --config vite.dev.config.js",
    "check": "node dev/check.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.1",
    "@automerge/automerge-repo": "^2.1.0",
    "wordgard": "^0.1.0"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.0.4",
    "playwright": "^1.62.1",
    "vite": "^7.1.9",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
